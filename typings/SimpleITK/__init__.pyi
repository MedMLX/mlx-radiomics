"""Used SimpleITK 2.5.6 geometry and I/O contracts; vectors use physical x/y/z order."""

from collections.abc import Iterable, Sequence
from pathlib import Path
from typing import Final

import numpy as np
from numpy.typing import NDArray

sitkNearestNeighbor: Final[int]
sitkLinear: Final[int]
sitkBSpline: Final[int]
sitkFloat32: Final[int]
sitkFloat64: Final[int]

class Image:
    def GetDimension(self) -> int: ...
    def GetSize(self) -> tuple[int, ...]: ...
    def GetPixelID(self) -> int: ...
    def GetNumberOfComponentsPerPixel(self) -> int: ...
    def GetSpacing(self) -> tuple[float, ...]: ...
    def GetOrigin(self) -> tuple[float, ...]: ...
    def GetDirection(self) -> tuple[float, ...]: ...
    def SetSpacing(self, spacing: Sequence[float]) -> None: ...
    def SetOrigin(self, origin: Sequence[float]) -> None: ...
    def SetDirection(self, direction: Sequence[float]) -> None: ...
    def CopyInformation(self, srcImage: Image) -> None: ...
    def TransformContinuousIndexToPhysicalPoint(
        self, index: Sequence[float]
    ) -> tuple[float, ...]: ...
    def TransformPhysicalPointToContinuousIndex(
        self, point: Sequence[float]
    ) -> tuple[float, ...]: ...

class ImageFileReader:
    def SetFileName(self, fn: str) -> None: ...
    def ReadImageInformation(self) -> None: ...
    def GetDimension(self) -> int: ...
    def GetSize(self) -> tuple[int, ...]: ...
    def GetPixelID(self) -> int: ...
    def GetSpacing(self) -> tuple[float, ...]: ...
    def GetOrigin(self) -> tuple[float, ...]: ...
    def GetDirection(self) -> tuple[float, ...]: ...

class ResampleImageFilter:
    def SetReferenceImage(self, refImage: Image) -> None: ...
    def SetSize(self, Size: Sequence[int]) -> None: ...
    def SetOutputSpacing(self, OutputSpacing: Sequence[float]) -> None: ...
    def SetOutputDirection(self, OutputDirection: Sequence[float]) -> None: ...
    def SetOutputOrigin(self, OutputOrigin: Sequence[float]) -> None: ...
    def SetInterpolator(self, Interpolator: int) -> None: ...
    def SetOutputPixelType(self, OutputPixelType: int) -> None: ...
    def SetUseNearestNeighborExtrapolator(
        self, UseNearestNeighborExtrapolator: bool,
    ) -> None: ...
    def Execute(self, image1: Image) -> Image: ...

class RecursiveGaussianImageFilter:
    def SetDirection(self, direction: int) -> None: ...
    def SetOrder(self, order: int) -> None: ...
    def SetSigma(self, sigma: float) -> None: ...
    def SetNormalizeAcrossScale(self, normalize: bool) -> None: ...
    def Execute(self, image: Image) -> Image: ...

class LaplacianRecursiveGaussianImageFilter:
    def SetSigma(self, sigma: float) -> None: ...
    def SetNormalizeAcrossScale(self, normalize: bool) -> None: ...
    def Execute(self, image: Image) -> Image: ...

def Cast(image: Image, pixelID: int) -> Image: ...
def GetArrayFromImage(image: Image) -> NDArray[np.generic]: ...
def GetArrayViewFromImage(image: Image) -> NDArray[np.generic]: ...
def GetImageFromArray(arr: NDArray[np.generic], isVector: bool | None = None) -> Image: ...
def ReadImage(
    fileName: str | Path | Iterable[str] | Iterable[Path],
    outputPixelType: int = -1,
    imageIO: str = "",
) -> Image: ...
def WriteImage(
    image: Image,
    fileName: str | Path | Iterable[str] | Iterable[Path],
    useCompression: bool = False,
    compressionLevel: int = -1,
    *,
    imageIO: str = "",
    compressor: str = "",
) -> None: ...
def RegionOfInterest(
    image1: Image, size: Sequence[int] = ..., index: Sequence[int] = ...
) -> Image: ...
